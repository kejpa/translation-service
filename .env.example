# FastAPI
DATABASE_URL=sqlite:///translation_memory.db

# Server
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# Translation
MAX_CHUNK_SIZE=4000
TEMPERATURE=0

# Thresholds for determining what to do with the results
REUSE_THRESHOLD=85
REFERENCE_THRESHOLD=60

# Logging
LOG_LEVEL=INFO
